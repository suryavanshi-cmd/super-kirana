{
  "name": "voice-gateway",
  "private": true,
  "version": "1.0.0",
  "description": "Super Kirana voice-entry gateway: Sarvam STT + deterministic Marathi khata parser (Cloud Run)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --minify --sourcemap --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node --enable-source-maps dist/server.mjs",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:parse": "tsx scripts/bench-parse.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "fastify": "^5.2.0",
    "jose": "^6.0.0",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
